{
  "name": "prometheus",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "deploy": "npm run build && wrangler deploy",
    "dev": "vite",
    "start": "vite",
    "test": "vitest run && node --test test/embedded-build.node.mjs",
    "cf-typegen": "wrangler types",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.worker.json",
    "preview": "vite preview",
    "build:single": "npm run build && node build/single-file.mjs",
    "test:single": "npm run build:single && node --test test/frontend-build.node.mjs test/single-file-artifact.node.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "javascript-obfuscator": "^5.9.0",
    "typescript": "^5.5.2",
    "vite": "^8.3.4",
    "vitest": "~4.1.0",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "type": "module"
}
