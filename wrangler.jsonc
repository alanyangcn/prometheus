{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prometheus",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-10",
  "assets": {
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "account_id": "ac7eeee2ac55f6e94433bc62aad2da53",
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "STORAGE",
      "id": "219f845bda1a403e96d2705baad24173"
    }
  ]
}
