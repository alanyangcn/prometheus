{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prometheus-studio",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-10",
  "assets": {
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "account_id": "38230428abeeaf3dbe08223cfbf5f3fa",
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "STORAGE",
      "id": "7b1fcef07e01418999a395119048c775"
    }
  ],
  "workers_dev": true,
  "preview_urls": false
}
