{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prometheus",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-10",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "KV"
    }
  ]
}
