{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": [
    "server/**/*.ts",
    "worker-configuration.d.ts",
    "server/**/*.js",
    "shared/**/*.ts"
  ]
}
